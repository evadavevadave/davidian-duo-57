@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<urn:davidian:duo-57>
    a lv2:Plugin , lv2:AmplifierPlugin , lv2:SimulatorPlugin ;
    doap:name "Davidian Duo '57" ;
    doap:license <http://opensource.org/licenses/GPL-3.0> ;
    rdfs:comment "Tweed tube amplifier simulation modeled on the service diagram of a 1957 tweed 2x12 combo: four-triode 12AX7 input section with Normal and Bright channels, V3 gain stage and cathode follower, tweed treble/bass tone stack, cathodyne phase inverter and 6L6GC push-pull power amp with presence-shaped negative feedback and rectifier sag. 4x oversampled." ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "input" ;
        lv2:name "Input Jack" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Normal 1" ; rdf:value 0 ] ,
                       [ rdfs:label "Normal 2" ; rdf:value 1 ] ,
                       [ rdfs:label "Bright 1" ; rdf:value 2 ] ,
                       [ rdfs:label "Bright 2" ; rdf:value 3 ] ,
                       [ rdfs:label "Normal 1 + Bright 1 (Y cable)" ; rdf:value 4 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "vol_normal" ;
        lv2:name "Volume Normal" ;
        lv2:default 6 ;
        lv2:minimum 1 ;
        lv2:maximum 12
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "vol_bright" ;
        lv2:name "Volume Bright" ;
        lv2:default 6 ;
        lv2:minimum 1 ;
        lv2:maximum 12
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "treble" ;
        lv2:name "Treble" ;
        lv2:default 7 ;
        lv2:minimum 1 ;
        lv2:maximum 12
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "bass" ;
        lv2:name "Bass" ;
        lv2:default 5 ;
        lv2:minimum 1 ;
        lv2:maximum 12
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "presence" ;
        lv2:name "Presence" ;
        lv2:default 6 ;
        lv2:minimum 1 ;
        lv2:maximum 12
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "cab" ;
        lv2:name "Cabinet Sim" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "input_trim" ;
        lv2:name "Input Trim" ;
        lv2:default 0 ;
        lv2:minimum -24 ;
        lv2:maximum 24 ;
        units:unit units:db
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "output" ;
        lv2:name "Output Level" ;
        lv2:default 0 ;
        lv2:minimum -60 ;
        lv2:maximum 12 ;
        units:unit units:db
    ] .
