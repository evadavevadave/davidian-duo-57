@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<urn:davidian:duo-57>
    a lv2:Plugin ;
    lv2:binary <duo57@LIB_EXT@> ;
    rdfs:seeAlso <duo57.ttl> .

# The build fills in the library extension and the GUI class (WindowsUI, CocoaUI or X11UI).
<urn:davidian:duo-57>
    ui:ui <urn:davidian:duo-57#ui> .

<urn:davidian:duo-57#ui>
    a ui:@UI_CLASS@ ;
    ui:binary <duo57_ui@LIB_EXT@> ;
    lv2:requiredFeature ui:parent ;
    lv2:optionalFeature ui:resize , ui:idleInterface ;
    lv2:extensionData ui:idleInterface .
